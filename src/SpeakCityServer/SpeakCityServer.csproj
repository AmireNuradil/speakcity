<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>SpeakCityServer</AssemblyName>
    <RootNamespace>SpeakCityServer</RootNamespace>
    <Version>0.2.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../SpeakCity/ApiClient.cs" Link="ApiClient.cs" />
    <Compile Include="../SpeakCity/ApiConfig.cs" Link="ApiConfig.cs" />
    <Compile Include="../SpeakCity/AppRouter.cs" Link="AppRouter.cs" />
    <Compile Include="../SpeakCity/SpeechWorkerClient.cs" Link="SpeechWorkerClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../ui/**/*" Exclude="../../ui/tests/**;../../ui/README.md" Link="ui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../content/scenarios.json" Link="content/scenarios.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
